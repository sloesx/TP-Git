ab}}\pard\plain \s20\qj\li2835\sb120\keepn\widctlpar\aspalpha\aspnum\faauto\ls1\outlinelevel0\adjustright\rin0\lin2835\itap0 \scaps\f1\ul\lang1036\kerning28\cgrid {ulrich\par }\pard\plain \s16\qj\li2835\sa120\widctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin2835\itap0 \f1\lang1036\cgrid {Et toi, t\rquote es qui\~?\par }\pard\plain \s18\qj\widctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \f1\lang1036\cgrid {Sissi agrandit son sourire, de plus en plus tendre et complice.\par {\listtext\pard\plain\s20 \scaps\f1\kerning28 \hich\af1\dbch\af0\loch\f1 48 - \tab}}\pard\plain \s20\qj\li2835\sb120\keepn\widctlpar\aspalpha\aspnum\faauto\ls1\outlinelevel0\adjustright\rin0\lin2835\itap0 \scaps\f1\ul\lang1036\kerning28\cgrid {sissi\par }\pard\plain \s16\qj\li2835\sa120\widctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin2835\itap0 \f1\lang1036\cgrid {Je suis Sissi\u8230\'c9 ta\u8230\'c9 (S\u251\'9ere d\rquote elle)\u8230\'c9 }{\caps petite amie\~}{! \par }\pard\plain \s18\qj\widctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \f1\lang1036\cgrid {Ulrich la regarde avec intensit\u233\'8e, cherchant \u224\'88 se rappeler\u8230\'c9 et soudain, il semble de nouveau faible et ferme les yeux, pris d\rquote un l\u233\'8eger malaise.\par {\pntext\pard\plain\s17 \b\caps\f1 \hich\af1\dbch\af0\loch\f1 6.\tab}}\pard\plain \s17\qj\fi-360\li360\sb240\sa120\widctlpar\jclisttab\tx360{\*\pn \pnlvlbody\ilvl0\ls2\pnrnot0\pndec\pnstart1\pnindent360\pnsp120\pnhang{\pntxta .}}\aspalpha\aspnum\faauto\ls2\adjustright\rin0\lin360\itap0 \b\caps\f1\ul\lang1036\cgrid {flash  d\rquote ulrich. ext. cour de r\u233\'8ecr\u233\'8eation \endash  jour\par }\pard\plain \s19\qj\sb120\widctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \scaps\f1\ul\lang1036\cgrid {R\u233\'8eut de \u171\'c7\~Big Bogue\~\u187\'c8, s\u233\'8equence #3. Noir et blanc\~ou s\u233\'8epia\~?\par {\listtext\pard\plain\s20 \i\scaps\f1\kerning28 \hich\af1\dbch\af0\loch\f1 49 - \tab}}\pard\plain \s20\